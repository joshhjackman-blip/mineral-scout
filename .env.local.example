NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required by /api/cron/scrape-permits and /api/cron/scrape-wells (fail-closed).
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
# If unset, cron routes return 401 and do not scrape.
CRON_SECRET=
# Pad-activity on-demand imagery at GET /api/pad-activity/sentinel:
#   1) SkyFi archive thumbnail when SKYFI_API_KEY is set (no paid order)
#   2) Else pad-centered Sentinel-2 COG crop (~1.3 km) via /api/pad-activity/sentinel/chip
# Paywall stub (keep false while testing): SKYFI_PAYWALL_ENABLED=false
SKYFI_API_KEY=
# SKYFI_PAYWALL_ENABLED=false
# Hi-res Mapbox Satellite chips (NAIP fallback) via POST /api/pad-activity/hires:
# MAPBOX_TOKEN=   # or NEXT_PUBLIC_MAPBOX_TOKEN already used by the map
# Weekly before/after chips still need SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# in GH Actions when --enable-sentinel is used.
ANTHROPIC_API_KEY=
# Used for team invites + /book-demo requests (to management@mineralmapllc.com).
RESEND_API_KEY=

# ── Stripe billing: $100/seat/mo + $0.50 skip-trace ─────────────────────
# Create in Stripe Dashboard:
#   1) Product "Mineral Map Seat" → recurring Price $100/month (licensed)
#   2) Billing → Meters → event name e.g. "skip_trace" (sum aggregation)
#   3) Product "Skip Trace" → metered Price $0.50/unit linked to that meter
# Webhook events: checkout.session.completed, customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SEAT_PRICE_ID=
NEXT_PUBLIC_STRIPE_SEAT_PRICE_ID=
STRIPE_SKIPTRACE_PRICE_ID=
STRIPE_SKIPTRACE_METER_EVENT_NAME=skip_trace
# Soft paywall: redirect unpaid logged-in users to /pricing.
# Keep false until Stripe catalog is live. Before enabling, run once from
# Admin → Provision → "Grandfather existing users" so current accounts stay free
# (billing_exempt=true waives seat + skip-trace; new signups still pay).
BILLING_PAYWALL_ENABLED=false

# Require current Platform Services Agreement signature before map/CRM.
# On by default. Set false only for emergency unlock.
# AGREEMENT_GATE_ENABLED=false
# Legacy (unused by new checkout; safe to leave blank):
# STRIPE_PRICE_ID=
# NEXT_PUBLIC_STRIPE_PRICE_ID=
# NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=

# Skip-trace providers (server-only). Routing by owner type:
#   entity (LLC / trust / estate / …) -> BatchData first
#   person (individual)               -> IDICORE first
#   Tracerfy is the shared last-resort backstop.
BATCHSKIPTRACING_API_KEY=
IDICORE_API_KEY=
# idiCORE POST endpoint (leave blank until wired; the person path then falls
# back to Tracerfy). Set alongside IDICORE_API_KEY to activate.
IDICORE_API_URL=
TRACERFY_API_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
