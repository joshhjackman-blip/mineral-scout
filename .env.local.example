SUPABASE_SERVICE_ROLE_KEY=
# Pad-activity Sentinel chips use Element84 Earth Search (public, no key).
# Hi-res Needs Review prefers Mapbox Satellite (current). Falls back to
# USDA NAIP via Planetary Computer when Mapbox is unavailable (NAIP for
# TX is often 2–4 years old). Uses NEXT_PUBLIC_MAPBOX_TOKEN.
# Weekly job needs SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
