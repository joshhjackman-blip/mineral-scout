NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
# Add that origin (and /auth) to Supabase Auth → URL configuration → Redirect URLs
# so invite join links can land. Example: https://getmineralmap.com/auth**

SUPABASE_SERVICE_ROLE_KEY=
# Required by /api/cron/scrape-permits and /api/cron/scrape-wells (fail-closed).
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically.
# If unset, cron routes return 401 and do not scrape.
CRON_SECRET=
# Pad-activity on-demand imagery at GET /api/pad-activity/sentinel:
#   1) SkyFi archive thumbnail when SKYFI_API_KEY is set (no paid order)
#   2) Else pad-centered Sentinel-2 COG crop (~1.3 km) via /api/pad-activity/sentinel/chip
# Paywall stub (keep false while testing): SKYFI_PAYWALL_ENABLED=false
SKYFI_API_KEY=
# SKYFI_PAYWALL_ENABLED=false
# Hi-res Mapbox Satellite chips (NAIP fallback) via POST /api/pad-activity/hires:
# MAPBOX_TOKEN=   # or NEXT_PUBLIC_MAPBOX_TOKEN already used by the map
# Weekly before/after chips still need SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# in GH Actions when --enable-sentinel is used.
ANTHROPIC_API_KEY=
# Used for team invites + /book-demo requests (to management@mineralmapllc.com).
# Also required to email team-admin and teammate join links (so you never
# create logins by hand in the Supabase dashboard).
# /get-started signup requests email management@; Accept emails the applicant
# a join link through the same Resend account.
RESEND_API_KEY=

# ── Stripe billing: access is free; $1 skip-trace per phone hit ──
# Card on file at skip-trace signup (Checkout mode=setup). Hits accrue in
# skip_trace_usage.billable_count ($1 only when a phone number comes back).
# On the 1st, /api/cron/charge-skiptrace charges the team's default card
# for the previous calendar month (charge_automatically). No card / past-due
# blocks live skip-traces (402). Cache hits stay free. Do not attach a
# metered skip-trace price to any subscription — that would double-bill.
# Skip-trace is waived only for Mineral Map (management@) and Jordan's
# Great Plains workspace (including invited members).
# Webhook events: checkout.session.completed (mode=setup), invoice.paid,
# invoice.payment_failed, customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Legacy seat catalog (unused for access; skip-trace invoices do not need these):
# STRIPE_SEAT_PRICE_ID=
# NEXT_PUBLIC_STRIPE_SEAT_PRICE_ID=
# STRIPE_SKIPTRACE_PRICE_ID=
# STRIPE_SKIPTRACE_METER_EVENT_NAME=

# Require current Platform Services Agreement signature before map/CRM.
# On by default. Set false only for emergency unlock.
# AGREEMENT_GATE_ENABLED=false
# Legacy (unused by new checkout; safe to leave blank):
# STRIPE_PRICE_ID=
# NEXT_PUBLIC_STRIPE_PRICE_ID=
# NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=

# Skip-trace providers (server-only). Order:
#   idiCORE first, then Accurate Append, BatchData backup, Tracerfy last-resort.
# Vercel: add ACCURATE_APPEND_API_KEY (Production + Preview) with the
# Accurate Append trial/license key. Leave blank to skip this provider.
ACCURATE_APPEND_API_KEY=
BATCHSKIPTRACING_API_KEY=
# idiCORE is a TWO-STEP API: authenticate at the auth URL to get a bearer
# token, then POST the search to the search URL. Enabled once IDICORE_SEARCH_URL
# is set; otherwise the person path falls back to Accurate Append / Tracerfy.
# idiCORE is #1 in the chain: a phone or email hit stops the cascade, so
# Accurate Append only runs on idiCORE misses.
#   Test env:  auth   https://login-api-test.idicore.com/apiclient
#              search https://api-test.idicore.com/search/MineralMap
#   Prod env:  swap those hosts off `-test` when idiCORE promotes the account.
IDICORE_AUTH_URL=
IDICORE_SEARCH_URL=
# idiCORE /apiclient uses HTTP Basic auth: base64(CLIENT_ID:CLIENT_SECRET),
# with a JSON body of permissible-use codes. CLIENT_SECRET is emailed
# separately. GLBA/DPPA default to the values in idiCORE's sample.
IDICORE_CLIENT_ID=
IDICORE_CLIENT_SECRET=
IDICORE_GLBA=otheruse
IDICORE_DPPA=none
# Set to "bearer" if the account requires an "Authorization: Bearer <token>"
# prefix on the search call; leave blank to send the raw token value.
IDICORE_AUTH_SCHEME=
# Legacy single-URL fallback (kept for back-compat; prefer the two-step vars).
IDICORE_API_KEY=
IDICORE_API_URL=
# idiCORE allow-lists ONE static US IP. Vercel Pro egresses from rotating AWS
# IPs, so route idiCORE calls through a fixed-IP proxy and register THAT IP
# with idiCORE. Format: http://user:pass@proxy-host:port (QuotaGuard/Fixie, or
# a US VM with an Elastic IP). Leave blank to call directly (no static IP).
# Must stay set on Production — skip-trace uses undici (not Next fetch) so
# this proxy is actually applied. Auth does not count as a search; only
# POST /search/MineralMap increments idiCORE's search quota.
IDICORE_PROXY_URL=
TRACERFY_API_KEY=

# Miss-queue researcher (Vercel cron /api/cron/research-skiptrace every 15 min).
# Unwraps tax-roll trusts (TR / LVG / SNP) and looks up TX Comptroller
# officers for LLC/LP/INC, then re-runs the skip-trace chain above.
# Hits write to skip_trace_cache + every deal for that owner. No extra
# provider keys required; not billed to the customer.

NEXT_PUBLIC_POSTHOG_KEY=
